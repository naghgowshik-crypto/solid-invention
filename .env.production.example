# Production Environment Variables Template for Sreyas Media Club
# IMPORTANT: DO NOT COMMIT REAL PRODUCTION SECRETS OR PASSWORDS TO GIT

# Spring Boot Configuration
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# Database Configuration (PostgreSQL)
DATABASE_URL=jdbc:postgresql://<DB_HOST>:5432/<DB_NAME>
DATABASE_USERNAME=<DB_USER>
DATABASE_PASSWORD=<DB_SECURE_PASSWORD>
DATABASE_DRIVER=org.postgresql.Driver

# Security Secrets (Must be at least 256-bit / 32 characters)
JWT_SECRET=<SUPPLY_SECURE_RANDOM_256_BIT_KEY>

# Frontend & CORS Configuration
FRONTEND_URL=https://<YOUR_FRONTEND_DOMAIN>
VITE_API_BASE_URL=https://<YOUR_API_DOMAIN>/api

# Persistent Cloud Object Storage (Fixes Render Ephemeral Disk Blocker)
STORAGE_PROVIDER=s3
STORAGE_BUCKET=<YOUR_S3_OR_CLOUDINARY_BUCKET_NAME>
STORAGE_REGION=<YOUR_BUCKET_REGION_E_G_us-east-1>
STORAGE_ENDPOINT=<OPTIONAL_CUSTOM_S3_ENDPOINT_URL>
STORAGE_ACCESS_KEY=<YOUR_CLOUD_ACCESS_KEY_ID>
STORAGE_SECRET_KEY=<YOUR_CLOUD_SECRET_ACCESS_KEY>

